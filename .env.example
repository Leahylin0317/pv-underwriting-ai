# Copy this file to .env before using real providers.
# Never commit the real .env file.

PV_VLM_BASE_URL=
PV_VLM_API_KEY=
PV_VLM_MODEL=
PV_VLM_TIMEOUT_SECONDS=60

# Optional. Relative paths are resolved from the project root.
# When omitted, the non-production sample catalog is used.
PV_COMPONENT_CATALOG_PATH=
