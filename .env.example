# Copy this file to .env before using real providers.
# Never commit the real .env file.

# Alibaba Cloud Model Studio (DashScope), Beijing compatibility endpoint.
# If your console provides a workspace-specific endpoint, use that instead.
PV_VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
PV_VLM_API_KEY=
PV_VLM_MODEL=qwen3.8-flash
PV_VLM_TIMEOUT_SECONDS=120
PV_VLM_USE_SYSTEM_PROXY=false
# 默认直连，避免继承系统代理导致响应超时；需要代理时设为 true
PV_VLM_TRUST_ENV=false

# Optional. Relative paths are resolved from the project root.
# When omitted, the imported local catalog (2026-10-01) is used.
PV_COMPONENT_CATALOG_PATH=
# Optional Solar Stack read-only Partner API key. Keep it server-side in .env.
# Exact GLOBAL-market model matches may fill rated power, hail test, and module static loads.
# Blank fields remain unknown; module static loads are never treated as design wind/snow loads.
PV_SOLAR_STACK_API_KEY=
# Optional verified component catalog endpoint. Receives GET ?model=<exact model>.
# Response: {"verified":true,"profile":{...ComponentProfile...}}; 404 means no match.
# Only manufacturer source URLs on the approved domain list are accepted.
PV_COMPONENT_ONLINE_CATALOG_URL=
PV_COMPONENT_ONLINE_CATALOG_API_KEY=
PV_COMPONENT_APPROVED_SOURCE_DOMAINS=jasolar.com
# Optional server-side component search through Brave Search API. Brave requires
# its own API key. Without one, the workbench provides browser search links and
# local variant candidates; search snippets never become underwriting values.
PV_COMPONENT_SEARCH_API_KEY=
# Optional comma-separated domains to search in a separate priority pass.
# General web search runs only when PV_COMPONENT_SEARCH_API_KEY is configured.
PV_COMPONENT_TRUSTED_SOURCE_DOMAINS=
# Human-confirmed missing values are written here and used only to fill empty fields.
PV_COMPONENT_CORRECTIONS_PATH=outputs/component-corrections.json
# Optional Amap Web Service geocoding key for address candidates in the workbench.
# Keep the actual key in .env only. Returned coordinates require manual confirmation.
PV_AMAP_WEB_SERVICE_KEY=
# Amap calls use a direct HTTPS connection by default because local proxying
# caused timeouts in this environment. Set true only if your network requires it.
PV_AMAP_USE_SYSTEM_PROXY=false
PV_BUSINESS_RULES_PATH=
# Historical weather lookup. The public Open-Meteo endpoint needs no API key.
PV_WEATHER_BASE_URL=https://archive-api.open-meteo.com/v1/archive
PV_WEATHER_LOOKBACK_DAYS=3650
PV_WEATHER_DATA_LAG_DAYS=7
PV_WEATHER_TIMEOUT_SECONDS=30

# Optional, separate Web-end (JS API) credentials for the interactive Amap
# satellite layer. The Web Service Key above is for backend geocoding only.
# JS API credentials are delivered to the browser after consent; restrict the
# JS API key to the local/deployed domain in Amap Console.
PV_AMAP_JS_API_KEY=
PV_AMAP_JS_SECURITY_CODE=
PV_MAP_TIMEOUT_SECONDS=10

# Optional Copernicus Data Space Sentinel Hub credentials (server-side only).
# Create an OAuth client in Copernicus Data Space; never expose these values in the browser.
PV_SENTINEL_HUB_CLIENT_ID=
PV_SENTINEL_HUB_CLIENT_SECRET=
PV_SENTINEL_TIMEOUT_SECONDS=45
PV_SENTINEL_LOOKBACK_DAYS=180
PV_SENTINEL_MAX_CLOUD_COVER_PERCENT=40
PV_SENTINEL_RADIUS_M=1000
PV_SENTINEL_USE_SYSTEM_PROXY=false

# Local case history database. Do not place this file in version control.
PV_CASE_DB_PATH=outputs/pv-underwriting.sqlite3
# 0 disables automatic deletion; set only to the retention period approved by the data owner.
PV_CASE_RETENTION_DAYS=0

# Optional local role-based authentication. Set both admin values before enabling it.
PV_AUTH_ENABLED=false
PV_ADMIN_USERNAME=
PV_ADMIN_PASSWORD=
